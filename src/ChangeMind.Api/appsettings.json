{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=changemind_db;Username=changemind;Password=changemind_pass;"
  },
  "Jwt": {
    "Secret": "this-is-a-super-secret-key-that-must-be-at-least-32-characters-long-change-in-production",
    "Issuer": "ChangeMindApi",
    "Audience": "ChangeMindApp",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": { "Application": "ChangeMind.Api" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://elasticsearch:9200",
          "indexFormat": "changemind-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv8",
          "numberOfShards": 1,
          "numberOfReplicas": 0
        }
      }
    ]
  },
  "Timeout": {
    "Database": {
      "CommandTimeoutSeconds": 5
    }
  },
  "Cache": {
    "ConnectionString": "localhost:6379,password=changemind_redis_pass",
    "DefaultTtlSeconds": 300,
    "InstanceName": "changemind:",
    "Resilience": {
      "RetryCount": 3,
      "RetryBaseDelayMs": 200,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakDurationSeconds": 30,
      "OperationTimeoutMs": 1000,
      "MaxConcurrentOperations": 50,
      "ConcurrentQueueLimit": 0
    }
  },
  "Bulkhead": {
    "PaymentMaxConcurrent": 10,
    "PaymentQueueLimit": 5
  },
  "Idempotency": {
    "LockTtlMs": 5000,
    "ResponseTtlHours": 24
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": ""
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000" ]
  }
}
